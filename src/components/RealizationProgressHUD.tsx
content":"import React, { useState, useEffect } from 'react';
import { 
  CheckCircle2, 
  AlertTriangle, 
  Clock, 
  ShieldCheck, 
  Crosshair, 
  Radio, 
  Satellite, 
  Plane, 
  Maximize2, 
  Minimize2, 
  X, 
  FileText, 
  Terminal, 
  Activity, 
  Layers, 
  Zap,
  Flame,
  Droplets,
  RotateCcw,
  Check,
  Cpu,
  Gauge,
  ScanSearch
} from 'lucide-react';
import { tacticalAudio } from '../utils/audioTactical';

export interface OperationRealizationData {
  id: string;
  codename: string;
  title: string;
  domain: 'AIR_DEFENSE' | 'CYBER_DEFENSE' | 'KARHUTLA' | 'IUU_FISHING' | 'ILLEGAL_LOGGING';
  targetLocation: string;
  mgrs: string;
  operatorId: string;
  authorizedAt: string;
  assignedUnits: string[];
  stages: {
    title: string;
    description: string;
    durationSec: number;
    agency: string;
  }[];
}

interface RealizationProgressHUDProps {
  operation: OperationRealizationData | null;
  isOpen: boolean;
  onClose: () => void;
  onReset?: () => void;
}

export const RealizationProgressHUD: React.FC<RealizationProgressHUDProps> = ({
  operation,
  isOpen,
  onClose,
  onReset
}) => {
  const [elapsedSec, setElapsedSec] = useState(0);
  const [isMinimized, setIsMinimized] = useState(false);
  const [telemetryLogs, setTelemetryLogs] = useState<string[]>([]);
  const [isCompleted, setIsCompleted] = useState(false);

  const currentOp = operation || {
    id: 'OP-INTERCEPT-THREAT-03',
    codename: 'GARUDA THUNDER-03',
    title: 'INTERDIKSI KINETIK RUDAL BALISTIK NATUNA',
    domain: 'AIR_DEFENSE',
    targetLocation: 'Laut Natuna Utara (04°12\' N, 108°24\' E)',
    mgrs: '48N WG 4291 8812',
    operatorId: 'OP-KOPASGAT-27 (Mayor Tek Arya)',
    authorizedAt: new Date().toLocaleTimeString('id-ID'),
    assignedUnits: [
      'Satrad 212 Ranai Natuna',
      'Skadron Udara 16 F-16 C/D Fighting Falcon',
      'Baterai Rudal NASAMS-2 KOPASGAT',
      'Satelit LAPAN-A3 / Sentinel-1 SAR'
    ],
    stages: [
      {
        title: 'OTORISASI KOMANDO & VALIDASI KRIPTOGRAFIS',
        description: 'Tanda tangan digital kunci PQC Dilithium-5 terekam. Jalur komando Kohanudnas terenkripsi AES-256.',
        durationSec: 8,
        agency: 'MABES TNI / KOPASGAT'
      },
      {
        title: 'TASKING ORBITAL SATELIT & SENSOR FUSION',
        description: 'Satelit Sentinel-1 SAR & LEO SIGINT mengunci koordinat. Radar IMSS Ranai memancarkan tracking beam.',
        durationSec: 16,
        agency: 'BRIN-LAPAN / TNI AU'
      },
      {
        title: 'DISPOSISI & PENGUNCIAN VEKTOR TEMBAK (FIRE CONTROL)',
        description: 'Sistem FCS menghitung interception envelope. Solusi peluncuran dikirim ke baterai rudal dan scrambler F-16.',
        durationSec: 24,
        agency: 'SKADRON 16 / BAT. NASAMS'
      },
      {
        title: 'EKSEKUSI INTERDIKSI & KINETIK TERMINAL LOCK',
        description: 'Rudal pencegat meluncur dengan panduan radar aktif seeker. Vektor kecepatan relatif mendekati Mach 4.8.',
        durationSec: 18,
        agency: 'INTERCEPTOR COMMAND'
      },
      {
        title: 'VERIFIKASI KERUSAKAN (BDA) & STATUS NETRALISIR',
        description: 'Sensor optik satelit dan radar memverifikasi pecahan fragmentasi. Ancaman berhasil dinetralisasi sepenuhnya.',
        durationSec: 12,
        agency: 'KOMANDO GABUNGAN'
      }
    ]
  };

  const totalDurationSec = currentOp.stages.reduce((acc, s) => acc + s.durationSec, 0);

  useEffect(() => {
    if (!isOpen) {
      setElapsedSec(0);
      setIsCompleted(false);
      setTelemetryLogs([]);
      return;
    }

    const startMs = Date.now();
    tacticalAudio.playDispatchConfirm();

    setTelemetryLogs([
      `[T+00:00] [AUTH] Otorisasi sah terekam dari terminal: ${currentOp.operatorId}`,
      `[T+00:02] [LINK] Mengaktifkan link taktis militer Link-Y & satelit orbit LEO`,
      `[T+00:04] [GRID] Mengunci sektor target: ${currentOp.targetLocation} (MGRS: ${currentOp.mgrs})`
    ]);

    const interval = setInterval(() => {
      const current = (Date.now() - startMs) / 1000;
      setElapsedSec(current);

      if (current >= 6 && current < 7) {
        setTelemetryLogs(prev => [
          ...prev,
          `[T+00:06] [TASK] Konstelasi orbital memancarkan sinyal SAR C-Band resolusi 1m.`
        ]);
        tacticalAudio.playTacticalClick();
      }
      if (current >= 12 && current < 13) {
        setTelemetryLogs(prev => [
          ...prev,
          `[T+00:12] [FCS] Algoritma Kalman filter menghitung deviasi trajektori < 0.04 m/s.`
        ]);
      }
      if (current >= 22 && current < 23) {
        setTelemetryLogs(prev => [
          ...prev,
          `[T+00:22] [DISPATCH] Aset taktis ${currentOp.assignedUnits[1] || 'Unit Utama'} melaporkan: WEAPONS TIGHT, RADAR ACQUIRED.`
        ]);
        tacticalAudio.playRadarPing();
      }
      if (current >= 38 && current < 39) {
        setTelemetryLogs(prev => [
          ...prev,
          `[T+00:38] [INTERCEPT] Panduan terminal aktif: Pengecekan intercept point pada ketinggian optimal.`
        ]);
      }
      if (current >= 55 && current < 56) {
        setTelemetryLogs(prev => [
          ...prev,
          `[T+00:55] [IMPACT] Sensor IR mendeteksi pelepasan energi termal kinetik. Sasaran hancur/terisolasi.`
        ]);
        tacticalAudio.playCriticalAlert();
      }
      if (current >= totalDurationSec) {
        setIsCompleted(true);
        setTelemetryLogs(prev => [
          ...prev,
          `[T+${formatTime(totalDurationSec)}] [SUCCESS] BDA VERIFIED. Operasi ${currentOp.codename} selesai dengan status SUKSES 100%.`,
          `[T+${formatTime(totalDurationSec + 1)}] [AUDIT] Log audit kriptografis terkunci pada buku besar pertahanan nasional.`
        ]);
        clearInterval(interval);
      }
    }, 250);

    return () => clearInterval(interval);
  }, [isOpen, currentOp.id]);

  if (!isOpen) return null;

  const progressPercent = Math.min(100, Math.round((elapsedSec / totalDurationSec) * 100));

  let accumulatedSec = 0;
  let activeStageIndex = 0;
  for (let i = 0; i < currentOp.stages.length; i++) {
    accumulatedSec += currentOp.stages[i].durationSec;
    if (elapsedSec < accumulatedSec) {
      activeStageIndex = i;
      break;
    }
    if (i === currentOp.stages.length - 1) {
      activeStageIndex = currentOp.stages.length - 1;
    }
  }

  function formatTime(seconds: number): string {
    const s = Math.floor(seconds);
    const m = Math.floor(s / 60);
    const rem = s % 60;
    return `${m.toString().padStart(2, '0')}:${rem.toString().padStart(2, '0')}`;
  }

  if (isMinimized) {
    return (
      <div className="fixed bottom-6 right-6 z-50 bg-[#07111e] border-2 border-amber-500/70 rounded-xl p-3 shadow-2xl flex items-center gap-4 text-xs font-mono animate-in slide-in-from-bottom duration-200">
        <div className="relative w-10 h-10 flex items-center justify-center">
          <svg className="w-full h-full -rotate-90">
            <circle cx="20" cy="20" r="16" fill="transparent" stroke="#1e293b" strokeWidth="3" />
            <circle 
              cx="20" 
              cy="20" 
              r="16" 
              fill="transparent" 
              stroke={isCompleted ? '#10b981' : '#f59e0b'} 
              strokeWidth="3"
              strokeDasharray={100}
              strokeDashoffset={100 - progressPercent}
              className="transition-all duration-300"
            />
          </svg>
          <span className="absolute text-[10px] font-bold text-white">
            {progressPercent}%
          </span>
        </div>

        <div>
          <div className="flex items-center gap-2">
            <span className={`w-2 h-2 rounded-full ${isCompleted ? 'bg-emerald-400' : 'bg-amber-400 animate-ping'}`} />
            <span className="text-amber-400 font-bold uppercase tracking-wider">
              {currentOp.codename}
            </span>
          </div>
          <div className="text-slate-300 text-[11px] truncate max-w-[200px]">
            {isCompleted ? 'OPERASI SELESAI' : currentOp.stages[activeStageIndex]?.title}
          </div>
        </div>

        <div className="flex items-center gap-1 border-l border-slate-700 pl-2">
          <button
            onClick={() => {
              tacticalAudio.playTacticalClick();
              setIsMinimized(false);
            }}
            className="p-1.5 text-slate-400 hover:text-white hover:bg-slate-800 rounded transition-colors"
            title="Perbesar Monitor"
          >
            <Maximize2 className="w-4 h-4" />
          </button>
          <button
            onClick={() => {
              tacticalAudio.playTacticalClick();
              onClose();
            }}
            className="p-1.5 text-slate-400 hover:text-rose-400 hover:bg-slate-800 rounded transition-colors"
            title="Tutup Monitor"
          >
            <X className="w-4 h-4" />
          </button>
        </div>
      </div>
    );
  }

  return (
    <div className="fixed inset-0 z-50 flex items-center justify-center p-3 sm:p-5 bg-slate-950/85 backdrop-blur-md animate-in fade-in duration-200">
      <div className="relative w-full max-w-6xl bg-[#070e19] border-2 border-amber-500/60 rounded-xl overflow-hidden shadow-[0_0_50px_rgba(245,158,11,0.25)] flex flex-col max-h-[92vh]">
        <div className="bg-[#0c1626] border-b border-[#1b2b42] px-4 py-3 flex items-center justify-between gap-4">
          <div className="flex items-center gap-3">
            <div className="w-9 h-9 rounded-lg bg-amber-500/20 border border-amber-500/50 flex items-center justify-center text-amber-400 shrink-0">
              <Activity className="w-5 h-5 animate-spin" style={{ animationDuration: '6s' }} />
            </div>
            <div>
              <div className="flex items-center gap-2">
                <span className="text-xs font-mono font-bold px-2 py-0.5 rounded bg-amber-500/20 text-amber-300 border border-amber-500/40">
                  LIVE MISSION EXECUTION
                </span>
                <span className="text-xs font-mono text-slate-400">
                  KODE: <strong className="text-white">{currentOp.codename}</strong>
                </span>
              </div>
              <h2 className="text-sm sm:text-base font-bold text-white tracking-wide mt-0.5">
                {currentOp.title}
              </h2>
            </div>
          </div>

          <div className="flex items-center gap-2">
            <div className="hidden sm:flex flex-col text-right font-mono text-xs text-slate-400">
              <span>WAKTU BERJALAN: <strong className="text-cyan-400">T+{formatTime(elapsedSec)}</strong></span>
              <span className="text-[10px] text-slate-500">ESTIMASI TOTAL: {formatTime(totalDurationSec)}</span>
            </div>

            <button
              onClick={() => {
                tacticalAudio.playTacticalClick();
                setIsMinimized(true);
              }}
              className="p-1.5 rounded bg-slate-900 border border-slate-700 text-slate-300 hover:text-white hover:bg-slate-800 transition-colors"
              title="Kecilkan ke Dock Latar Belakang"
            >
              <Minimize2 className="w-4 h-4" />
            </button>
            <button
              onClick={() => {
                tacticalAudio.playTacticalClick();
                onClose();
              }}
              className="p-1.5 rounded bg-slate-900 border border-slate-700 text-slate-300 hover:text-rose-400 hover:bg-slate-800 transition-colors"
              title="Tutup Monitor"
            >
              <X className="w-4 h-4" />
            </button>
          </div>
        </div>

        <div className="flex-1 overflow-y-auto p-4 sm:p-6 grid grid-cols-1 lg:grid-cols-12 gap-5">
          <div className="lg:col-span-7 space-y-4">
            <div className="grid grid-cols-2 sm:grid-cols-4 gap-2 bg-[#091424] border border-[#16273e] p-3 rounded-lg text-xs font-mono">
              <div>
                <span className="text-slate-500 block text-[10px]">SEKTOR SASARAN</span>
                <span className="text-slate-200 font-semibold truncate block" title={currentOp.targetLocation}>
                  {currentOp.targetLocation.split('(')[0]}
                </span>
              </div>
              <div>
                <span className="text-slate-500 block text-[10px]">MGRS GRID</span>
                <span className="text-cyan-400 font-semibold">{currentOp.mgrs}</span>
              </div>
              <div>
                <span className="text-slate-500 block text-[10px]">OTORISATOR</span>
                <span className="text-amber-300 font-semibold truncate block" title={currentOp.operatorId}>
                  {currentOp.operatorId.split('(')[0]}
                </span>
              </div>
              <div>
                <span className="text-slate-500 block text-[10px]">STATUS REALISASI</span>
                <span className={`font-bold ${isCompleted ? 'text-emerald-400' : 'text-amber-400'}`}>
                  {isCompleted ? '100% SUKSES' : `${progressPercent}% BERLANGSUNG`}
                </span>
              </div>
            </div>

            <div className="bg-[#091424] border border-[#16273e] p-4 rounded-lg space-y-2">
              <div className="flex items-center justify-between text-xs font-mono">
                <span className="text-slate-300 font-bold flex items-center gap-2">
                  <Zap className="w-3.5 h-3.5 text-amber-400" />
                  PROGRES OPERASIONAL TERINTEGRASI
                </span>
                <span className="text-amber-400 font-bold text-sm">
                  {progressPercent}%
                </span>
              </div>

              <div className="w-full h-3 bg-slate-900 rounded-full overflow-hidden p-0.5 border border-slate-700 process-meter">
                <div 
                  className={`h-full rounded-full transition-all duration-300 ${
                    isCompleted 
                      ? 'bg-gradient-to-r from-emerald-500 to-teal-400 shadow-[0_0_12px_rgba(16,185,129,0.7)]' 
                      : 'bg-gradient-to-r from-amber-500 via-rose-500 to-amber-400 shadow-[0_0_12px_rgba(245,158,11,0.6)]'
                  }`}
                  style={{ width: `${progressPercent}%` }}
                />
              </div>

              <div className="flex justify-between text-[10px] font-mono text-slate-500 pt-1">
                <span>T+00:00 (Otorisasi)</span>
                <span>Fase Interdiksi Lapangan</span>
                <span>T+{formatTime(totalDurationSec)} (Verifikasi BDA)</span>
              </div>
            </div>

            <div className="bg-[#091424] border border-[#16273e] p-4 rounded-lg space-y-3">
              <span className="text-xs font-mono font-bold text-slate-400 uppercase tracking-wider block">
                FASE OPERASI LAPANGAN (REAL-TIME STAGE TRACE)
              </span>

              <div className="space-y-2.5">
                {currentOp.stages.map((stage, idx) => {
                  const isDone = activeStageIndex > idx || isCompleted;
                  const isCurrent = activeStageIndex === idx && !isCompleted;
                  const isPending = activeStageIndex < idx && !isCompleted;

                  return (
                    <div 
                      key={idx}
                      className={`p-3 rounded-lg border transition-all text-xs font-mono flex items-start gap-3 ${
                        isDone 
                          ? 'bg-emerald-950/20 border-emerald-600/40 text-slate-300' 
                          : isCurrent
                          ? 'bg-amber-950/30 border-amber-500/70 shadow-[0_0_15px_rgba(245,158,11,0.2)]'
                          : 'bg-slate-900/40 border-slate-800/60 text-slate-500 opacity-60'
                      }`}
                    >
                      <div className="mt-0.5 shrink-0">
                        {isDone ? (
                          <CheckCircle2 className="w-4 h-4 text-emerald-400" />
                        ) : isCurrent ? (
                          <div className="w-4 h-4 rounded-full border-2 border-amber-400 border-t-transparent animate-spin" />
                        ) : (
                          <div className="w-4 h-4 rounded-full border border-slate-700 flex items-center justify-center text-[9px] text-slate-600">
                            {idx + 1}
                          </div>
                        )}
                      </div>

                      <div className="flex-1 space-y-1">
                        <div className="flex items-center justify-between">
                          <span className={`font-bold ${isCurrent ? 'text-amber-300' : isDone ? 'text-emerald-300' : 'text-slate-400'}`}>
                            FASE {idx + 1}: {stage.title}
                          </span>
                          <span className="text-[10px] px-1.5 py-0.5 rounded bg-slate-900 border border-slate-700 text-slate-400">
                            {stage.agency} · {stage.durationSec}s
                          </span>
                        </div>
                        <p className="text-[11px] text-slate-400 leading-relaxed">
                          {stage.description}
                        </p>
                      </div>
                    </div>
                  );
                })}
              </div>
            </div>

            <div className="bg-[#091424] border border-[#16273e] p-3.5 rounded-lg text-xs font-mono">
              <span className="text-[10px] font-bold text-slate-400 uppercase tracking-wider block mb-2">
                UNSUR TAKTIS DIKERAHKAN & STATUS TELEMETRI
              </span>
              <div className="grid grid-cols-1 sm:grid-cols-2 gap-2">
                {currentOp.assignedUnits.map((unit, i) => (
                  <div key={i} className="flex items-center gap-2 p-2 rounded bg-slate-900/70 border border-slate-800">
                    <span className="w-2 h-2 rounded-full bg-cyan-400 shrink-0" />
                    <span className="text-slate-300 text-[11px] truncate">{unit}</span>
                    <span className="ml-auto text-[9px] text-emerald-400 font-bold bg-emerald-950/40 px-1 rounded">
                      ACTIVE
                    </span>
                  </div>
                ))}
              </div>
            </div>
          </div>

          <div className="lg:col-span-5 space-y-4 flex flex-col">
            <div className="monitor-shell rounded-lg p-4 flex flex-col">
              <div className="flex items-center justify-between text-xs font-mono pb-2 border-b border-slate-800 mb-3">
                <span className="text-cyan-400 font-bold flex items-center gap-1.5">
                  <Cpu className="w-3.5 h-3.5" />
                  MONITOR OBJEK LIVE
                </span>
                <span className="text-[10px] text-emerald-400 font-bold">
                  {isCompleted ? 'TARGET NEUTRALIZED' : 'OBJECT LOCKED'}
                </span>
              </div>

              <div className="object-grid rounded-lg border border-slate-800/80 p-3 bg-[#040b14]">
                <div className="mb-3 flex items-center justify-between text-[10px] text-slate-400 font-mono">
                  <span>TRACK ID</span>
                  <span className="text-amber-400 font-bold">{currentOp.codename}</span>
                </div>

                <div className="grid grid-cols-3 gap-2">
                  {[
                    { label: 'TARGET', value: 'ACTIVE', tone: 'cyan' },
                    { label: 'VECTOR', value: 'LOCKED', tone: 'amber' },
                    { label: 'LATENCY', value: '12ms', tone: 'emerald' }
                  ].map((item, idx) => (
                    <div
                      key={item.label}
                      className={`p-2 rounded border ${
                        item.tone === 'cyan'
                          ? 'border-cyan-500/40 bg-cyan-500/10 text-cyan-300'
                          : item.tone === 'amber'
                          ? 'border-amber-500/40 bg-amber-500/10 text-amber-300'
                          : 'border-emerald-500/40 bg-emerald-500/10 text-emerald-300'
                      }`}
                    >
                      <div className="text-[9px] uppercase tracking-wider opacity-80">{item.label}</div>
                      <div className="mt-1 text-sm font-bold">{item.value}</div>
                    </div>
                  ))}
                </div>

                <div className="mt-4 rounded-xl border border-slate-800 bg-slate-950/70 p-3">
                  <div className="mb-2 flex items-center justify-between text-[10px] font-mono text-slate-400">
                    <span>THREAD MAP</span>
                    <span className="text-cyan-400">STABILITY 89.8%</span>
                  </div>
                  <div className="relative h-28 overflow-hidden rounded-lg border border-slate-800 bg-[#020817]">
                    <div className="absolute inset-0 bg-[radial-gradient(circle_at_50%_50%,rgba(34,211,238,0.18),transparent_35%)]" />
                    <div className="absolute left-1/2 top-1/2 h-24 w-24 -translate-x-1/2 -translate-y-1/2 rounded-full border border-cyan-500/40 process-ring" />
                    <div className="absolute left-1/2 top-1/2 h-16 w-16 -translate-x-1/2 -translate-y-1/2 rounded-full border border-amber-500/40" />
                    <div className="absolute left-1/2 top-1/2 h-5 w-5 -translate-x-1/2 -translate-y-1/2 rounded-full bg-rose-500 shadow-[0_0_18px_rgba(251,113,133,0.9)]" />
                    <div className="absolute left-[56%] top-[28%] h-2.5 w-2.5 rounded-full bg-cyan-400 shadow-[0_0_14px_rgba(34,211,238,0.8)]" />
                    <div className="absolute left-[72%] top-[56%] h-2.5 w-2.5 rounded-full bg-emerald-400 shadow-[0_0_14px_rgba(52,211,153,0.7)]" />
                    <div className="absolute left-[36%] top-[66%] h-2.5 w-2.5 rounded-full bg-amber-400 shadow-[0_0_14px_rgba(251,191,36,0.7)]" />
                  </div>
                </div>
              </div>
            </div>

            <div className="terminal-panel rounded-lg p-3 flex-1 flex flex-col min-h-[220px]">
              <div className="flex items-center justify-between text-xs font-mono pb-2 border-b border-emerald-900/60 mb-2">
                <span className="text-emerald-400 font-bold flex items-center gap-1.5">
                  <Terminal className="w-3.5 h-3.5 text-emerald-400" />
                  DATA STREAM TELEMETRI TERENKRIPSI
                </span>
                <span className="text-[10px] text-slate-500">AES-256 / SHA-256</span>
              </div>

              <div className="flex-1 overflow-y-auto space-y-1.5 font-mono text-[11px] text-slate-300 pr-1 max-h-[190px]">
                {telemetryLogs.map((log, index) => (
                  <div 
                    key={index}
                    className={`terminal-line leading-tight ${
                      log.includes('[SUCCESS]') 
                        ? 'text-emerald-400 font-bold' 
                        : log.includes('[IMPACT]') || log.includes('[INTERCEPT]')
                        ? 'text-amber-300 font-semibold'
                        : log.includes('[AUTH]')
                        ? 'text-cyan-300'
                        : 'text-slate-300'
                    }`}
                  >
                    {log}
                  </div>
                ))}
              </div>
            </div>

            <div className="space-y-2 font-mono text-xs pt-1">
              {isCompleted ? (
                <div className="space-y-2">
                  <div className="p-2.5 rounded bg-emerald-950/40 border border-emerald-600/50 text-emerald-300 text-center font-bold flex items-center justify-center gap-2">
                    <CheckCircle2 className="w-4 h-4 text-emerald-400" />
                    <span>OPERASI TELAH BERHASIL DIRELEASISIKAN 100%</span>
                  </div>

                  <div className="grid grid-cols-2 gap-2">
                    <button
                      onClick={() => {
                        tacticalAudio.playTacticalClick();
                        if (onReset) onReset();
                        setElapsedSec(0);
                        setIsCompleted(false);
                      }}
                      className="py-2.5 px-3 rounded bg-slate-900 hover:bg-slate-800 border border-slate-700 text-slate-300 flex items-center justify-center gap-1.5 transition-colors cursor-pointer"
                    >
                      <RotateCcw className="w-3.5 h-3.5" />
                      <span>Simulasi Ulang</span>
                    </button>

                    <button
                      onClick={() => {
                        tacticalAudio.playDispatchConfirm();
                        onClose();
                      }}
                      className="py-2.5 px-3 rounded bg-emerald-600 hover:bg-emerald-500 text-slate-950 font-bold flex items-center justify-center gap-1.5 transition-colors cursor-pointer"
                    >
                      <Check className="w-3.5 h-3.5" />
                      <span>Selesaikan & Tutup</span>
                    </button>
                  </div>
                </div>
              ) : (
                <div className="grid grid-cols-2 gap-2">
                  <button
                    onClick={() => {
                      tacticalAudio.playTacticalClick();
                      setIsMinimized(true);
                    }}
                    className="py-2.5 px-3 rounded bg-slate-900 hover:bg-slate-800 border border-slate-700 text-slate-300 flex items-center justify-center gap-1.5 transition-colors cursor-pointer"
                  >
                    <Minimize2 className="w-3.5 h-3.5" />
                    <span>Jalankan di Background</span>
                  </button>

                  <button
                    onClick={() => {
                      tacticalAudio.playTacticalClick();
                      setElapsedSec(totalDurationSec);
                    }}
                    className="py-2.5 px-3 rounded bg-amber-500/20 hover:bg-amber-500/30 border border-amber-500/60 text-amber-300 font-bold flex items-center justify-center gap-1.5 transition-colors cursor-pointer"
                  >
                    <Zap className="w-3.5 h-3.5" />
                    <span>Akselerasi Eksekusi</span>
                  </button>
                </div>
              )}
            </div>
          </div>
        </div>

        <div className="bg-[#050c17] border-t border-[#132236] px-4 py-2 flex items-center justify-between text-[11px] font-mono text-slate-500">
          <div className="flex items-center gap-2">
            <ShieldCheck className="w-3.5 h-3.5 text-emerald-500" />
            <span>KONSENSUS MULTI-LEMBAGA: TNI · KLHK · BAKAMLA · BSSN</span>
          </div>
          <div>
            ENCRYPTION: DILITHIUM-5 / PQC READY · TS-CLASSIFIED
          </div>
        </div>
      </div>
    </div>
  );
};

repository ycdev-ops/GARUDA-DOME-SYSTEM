@import "tailwindcss";

:root {
  color-scheme: dark;
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-top: env(safe-area-inset-top, 0px);
  --cyber-bg: #020817;
  --cyber-panel: rgba(9, 18, 34, 0.96);
  --cyber-line: rgba(148, 163, 184, 0.18);
  --cyber-cyan: #67e8f9;
  --cyber-amber: #fbbf24;
  --cyber-emerald: #34d399;
  --cyber-rose: #fb7185;
  --terminal-bg: rgba(2, 6, 23, 0.92);
}

@layer base {
  * {
    box-sizing: border-box;
  }

  html,
  body,
  #root {
    min-height: 100%;
    min-height: 100dvh;
    margin: 0;
    background: var(--cyber-bg);
  }

  body {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    background:
      radial-gradient(circle at top, rgba(34, 211, 238, 0.14), transparent 30%),
      radial-gradient(circle at bottom right, rgba(251, 191, 36, 0.12), transparent 25%),
      var(--cyber-bg);
    color: #f8fafc;
    overflow-x: hidden;
    overscroll-behavior: none;
    -webkit-tap-highlight-color: transparent;
  }

  code,
  pre,
  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }
}

.mobile-shell {
  min-height: 100dvh;
  padding-bottom: calc(var(--safe-bottom) + 8px);
  padding-top: calc(var(--safe-top) + 0px);
}

::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #020617;
}

::-webkit-scrollbar-thumb {
  background: #1e293b;
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: #334155;
}

@keyframes radar-sweep {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.animate-radar {
  animation: radar-sweep 6s linear infinite;
  transform-origin: center center;
}

@keyframes cyber-glitch {
  0% { transform: translate(0); text-shadow: -1.5px 0 #06b6d4, 1.5px 0 #f43f5e; }
  20% { transform: translate(-1.5px, 1px); text-shadow: 1.5px 0 #06b6d4, -1.5px 0 #f43f5e; }
  40% { transform: translate(-0.5px, -1px); text-shadow: -1.5px 0 #10b981, 1.5px 0 #06b6d4; }
  60% { transform: translate(1.5px, 0.5px); text-shadow: 1.5px 0 #f43f5e, -1.5px 0 #06b6d4; }
  80% { transform: translate(0.5px, -0.5px); text-shadow: -1px 0 #06b6d4, 1px 0 #10b981; }
  100% { transform: translate(0); text-shadow: none; }
}

.animate-glitch {
  animation: cyber-glitch 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

@keyframes scanline-sweep {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(1000%); }
}

.animate-scanline {
  animation: scanline-sweep 4s linear infinite;
}

@keyframes glowPulse {
  0%, 100% {
    box-shadow: 0 0 0 rgba(103, 232, 249, 0.15);
    border-color: rgba(103, 232, 249, 0.34);
  }
  50% {
    box-shadow: 0 0 18px rgba(103, 232, 249, 0.28);
    border-color: rgba(103, 232, 249, 0.65);
  }
}

@keyframes dataShift {
  0% { transform: translateX(-12px); opacity: 0.6; }
  50% { transform: translateX(0); opacity: 1; }
  100% { transform: translateX(12px); opacity: 0.75; }
}

.cyber-panel {
  background: linear-gradient(180deg, rgba(9, 18, 34, 0.96), rgba(6, 12, 22, 0.96));
  border: 1px solid rgba(148, 163, 184, 0.2);
  box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.6), 0 0 24px rgba(14, 165, 233, 0.1);
}

.monitor-shell {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(4, 11, 20, 0.96), rgba(2, 6, 23, 0.96));
  border: 1px solid rgba(59, 130, 246, 0.34);
  box-shadow: inset 0 0 25px rgba(14, 165, 233, 0.08), 0 0 18px rgba(14, 165, 233, 0.12);
}

.monitor-shell::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(148, 163, 184, 0.06),
    rgba(148, 163, 184, 0.01) 20%,
    rgba(148, 163, 184, 0.02) 100%
  );
  pointer-events: none;
}

.object-grid {
  background-image:
    linear-gradient(rgba(103, 232, 249, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(103, 232, 249, 0.06) 1px, transparent 1px);
  background-size: 16px 16px;
}

.process-ring {
  animation: glowPulse 2.8s ease-in-out infinite;
}

.process-meter {
  position: relative;
  overflow: hidden;
}

.process-meter::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.16), transparent);
  transform: translateX(-100%);
  animation: dataShift 2.4s ease-in-out infinite;
}

.terminal-panel {
  background: linear-gradient(180deg, rgba(2, 6, 23, 0.96), rgba(2, 6, 17, 0.96));
  border: 1px solid rgba(34, 197, 94, 0.3);
  box-shadow: inset 0 0 18px rgba(34, 197, 94, 0.08), 0 0 20px rgba(34, 197, 94, 0.08);
}

.terminal-line {
  position: relative;
  padding-left: 1.15rem;
  color: rgba(209, 250, 229, 0.9);
}

.terminal-line::before {
  content: "$";
  position: absolute;
  left: 0;
  color: #34d399;
  font-weight: 700;
}

.cyan-glow {
  box-shadow: 0 0 18px rgba(34, 211, 238, 0.18);
}

.rose-glow {
  box-shadow: 0 0 18px rgba(251, 113, 133, 0.18);
}

.amber-glow {
  box-shadow: 0 0 18px rgba(251, 191, 36, 0.18);
}

.cyber-grid-scanlines {
  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255,0,0,0.03), rgba(0,255,0,0.01), rgba(0,0,255,0.03));
  background-size: 100% 3px, 6px 100%;
}

@media (max-width: 767px) {
  .mobile-shell {
    min-height: 100dvh;
  }

  body {
    font-size: 14px;
  }
}

@media print {
  body {
    background: #ffffff !important;
    color: #0f172a !important;
  }

  .no-print {
    display: none !important;
  }

  .print-only {
    display: block !important;
  }
}

